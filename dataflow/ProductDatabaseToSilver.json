{
	"name": "ProductDatabaseToSilver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLake",
						"type": "LinkedServiceReference"
					},
					"name": "FromBronze"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "ChangeDataType"
				},
				{
					"name": "FilterOrderID"
				},
				{
					"name": "RemoveDuplicate"
				},
				{
					"name": "AddAddressParts"
				},
				{
					"name": "SelectFinalColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          Product as string,",
				"          QuantityOrdered as string,",
				"          PriceEach as string,",
				"          OrderDate as string,",
				"          PurchaseAddress as string,",
				"          FileName as string,",
				"          LoadDate as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'datalake',",
				"     wildcardPaths:['Bronze/ProductDatabase']) ~> FromBronze",
				"RemoveDuplicate cast(output(",
				"          mycols as string,",
				"          OrderID as integer,",
				"          QuantityOrdered as integer,",
				"          PriceEach as double,",
				"          OrderDate as timestamp 'MM/dd/yy HH:mm',",
				"          PurchaseAddress as string",
				"     ),",
				"     errors: true) ~> ChangeDataType",
				"FromBronze filter(isInteger(OrderID)) ~> FilterOrderID",
				"FilterOrderID aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> RemoveDuplicate",
				"ChangeDataType derive(PurchaseStreetAddress = at(split(PurchaseAddress,','),1),",
				"          PurchaseCity = at(split(PurchaseAddress,','),2),",
				"          PutrchaseState = trim(at(split(trim(at(split(PurchaseAddress,','),3)),' '),1)),",
				"          PurchaseZipCode = trim(at(split(trim(at(split(PurchaseAddress,','),3)),' '),2))) ~> AddAddressParts",
				"AddAddressParts select(mapColumn(",
				"          OrderID,",
				"          Product,",
				"          QuantityOrdered,",
				"          PriceEach,",
				"          OrderDate,",
				"          PurchaseStreet = PurchaseStreetAddress,",
				"          PurchaseCity,",
				"          PurchaseState = PutrchaseState,",
				"          PurchaseZipCode,",
				"          FileName,",
				"          LoadDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectFinalColumns"
			]
		}
	}
}