					"server": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDatabaseTable_password')]"
					}
				}
			},
			"dependsOn": []
		},
