{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafattoriakaw"
		},
		"AzureSqlDatabaseTable_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseTable'"
		},
		"DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DataLake'"
		},
		"LS_SQLDB_SINK_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB_SINK'"
		},
		"LS_SQLDB_SOURCE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB_SOURCE'"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		},
		"DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountkaw.dfs.core.windows.net/"
		},
		"LS_SQLDB_SINK_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"LS_SQLDB_SINK_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"LS_SQLDB_SINK_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		}
	},
