{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafattoriakaw"
		},
		"AzureSqlDatabaseTable_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseTable'"
		},
		"DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DataLake'"
		},
		"LS_SQLDB_SINK_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB_SINK'"
		},
		"LS_SQLDB_SOURCE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB_SOURCE'"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"AzureSqlDatabaseTable_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		},
		"DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountkaw.dfs.core.windows.net/"
		},
		"LS_SQLDB_SINK_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"LS_SQLDB_SINK_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"LS_SQLDB_SINK_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb80.database.windows.net"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"LS_SQLDB_SOURCE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dba"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafattoriakaw_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabaseTable_password": {
						"value": "[parameters('AzureSqlDatabaseTable_password')]"
					},
					"DataLake_accountKey": {
						"value": "[parameters('DataLake_accountKey')]"
					},
					"LS_SQLDB_SINK_password": {
						"value": "[parameters('LS_SQLDB_SINK_password')]"
					},
					"LS_SQLDB_SOURCE_password": {
						"value": "[parameters('LS_SQLDB_SOURCE_password')]"
					},
					"AzureSqlDatabaseTable_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseTable_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseTable_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseTable_properties_typeProperties_userName')]"
					},
					"DataLake_properties_typeProperties_url": {
						"value": "[parameters('DataLake_properties_typeProperties_url')]"
					},
					"LS_SQLDB_SINK_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLDB_SINK_properties_typeProperties_server')]"
					},
					"LS_SQLDB_SINK_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLDB_SINK_properties_typeProperties_database')]"
					},
					"LS_SQLDB_SINK_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLDB_SINK_properties_typeProperties_userName')]"
					},
					"LS_SQLDB_SOURCE_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLDB_SOURCE_properties_typeProperties_server')]"
					},
					"LS_SQLDB_SOURCE_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLDB_SOURCE_properties_typeProperties_database')]"
					},
					"LS_SQLDB_SOURCE_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLDB_SOURCE_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "datafattoriakaw_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafattoriakaw_ArmTemplate_0')]"
			]
		},
		{
			"name": "datafattoriakaw_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafattoriakaw_ArmTemplate_1')]"
			]
		}
	]
}